# The default Sites-provisioned D1 world needs no external credentials and is shared-scripted.
WORLD_MODE=shared-scripted
# Public contract address shown/copied by the landing-page CA button.
CONTRACT_ADDRESS=XXXXX
# Set in Render to enable /admin. Use a unique password of at least 16 characters.
ADMIN_PASSWORD=
# Render only: use a persistent disk, not the ephemeral application directory.
# SQLITE_PATH=/var/data/silicon.sqlite
# Optional legacy Supabase adapter; configure all three together, never a partial set.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret, never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:5173
# Paid generation currently requires the Supabase adapter and explicit shared-ai mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_DAILY_REQUESTS=100
AI_DAILY_USD=1
AI_RESERVATION_USD=0.01
AI_INTERVAL_SECONDS=30
AI_CHARACTER_COOLDOWN_SECONDS=60
AI_PAIR_COOLDOWN_SECONDS=180
AI_TIMEOUT_MS=12000
# Optional verified X profile linking: confidential OAuth 2.0 Web App credentials, server-only.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Exact registered callback, including deployed hostname. HTTPS required outside localhost.
X_CALLBACK_URL=https://your-site.example/api/x/callback
